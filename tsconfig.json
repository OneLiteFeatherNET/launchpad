{
  // https://nuxt.com/docs/guide/concepts/typescript
  // One project per runtime, as Nuxt generates them: app code, Nitro server
  // code, code shared by both, and the Node-side config files. Each is checked
  // with only the globals and auto-imports that exist where it runs, so server
  // code reaching for an app composable is a compiler error, not a review note.
  // `pnpm typecheck` checks all four with `vue-tsc -b --noEmit`.
  "files": [],
  "references": [
    { "path": "./.nuxt/tsconfig.app.json" },
    { "path": "./.nuxt/tsconfig.server.json" },
    { "path": "./.nuxt/tsconfig.shared.json" },
    { "path": "./.nuxt/tsconfig.node.json" }
  ]
}
